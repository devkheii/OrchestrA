{
  "name": "democracy-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, auditable AI agent harness. See docs/SPEC.md (normative).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v01": "vitest run tests/security tests/runtime",
    "matrix": "node scripts/check-matrix.mjs",
    "check": "pnpm run typecheck && pnpm run matrix && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
