{
  "name": "democracy-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, auditable AI agent harness. See docs/SPEC.md (normative).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v01": "vitest run tests/security tests/runtime",
    "matrix": "node scripts/check-matrix.mjs",
    "check": "pnpm run typecheck && pnpm run matrix && pnpm run test",
    "dem": "tsx apps/cli/src/bin.ts",
    "build": "node scripts/build.mjs",
    "install:cli": "pnpm run build && npm link"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "better-sqlite3": "^11.10.0",
    "node-pty": "^1.1.0"
  },
  "bin": {
    "dem": "./dist/dem.mjs"
  }
}
